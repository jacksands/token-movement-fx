{
  "id": "token-movement-fx",
  "title": "Token Movement FX",
  "description": "Toca animações do Sequencer, configuradas no Automated Animations, quando um Token se move usando uma ação específica (Teleporte/Blink, Andar, Voar, etc.). Presets de teleporte podem ser delegados ao próprio Automated Animations, que assume som, animação, desaparecimento e movimento do token.",
  "version": "1.0.0-beta",
  "authors": [
    {
      "name": "Jack_Sands"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    {
      "src": "styles/token-movement-fx.css",
      "layer": "modules"
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "socket": true,
  "relationships": {
    "requires": [
      {
        "id": "sequencer",
        "type": "module"
      }
    ],
    "recommends": [
      {
        "id": "autoanimations",
        "type": "module"
      },
      {
        "id": "jb2a_patreon",
        "type": "module"
      }
    ]
  },
  "url": "https://github.com/jacksands/token-movement-fx",
  "manifest": "https://raw.githubusercontent.com/jacksands/token-movement-fx/refs/heads/main/module.json",
  "download": "https://github.com/jacksands/token-movement-fx/archive/refs/heads/main.zip"
}
